# Copy to .env.local for local development. On Vercel, add these under
# Project > Settings > Environment Variables. Everything is optional.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# The public URL once a domain is connected (no trailing slash).
# Leave empty on Vercel previews; the Vercel URL is detected automatically.
NEXT_PUBLIC_SITE_URL=

# Set to "true" ONLY after the real domain is live. Until then, search engines
# are told not to index the site.
NEXT_PUBLIC_ALLOW_INDEXING=

# ---------------------------------------------------------------------------
# Lead delivery (form submissions). Without any of these, leads are only
# logged and visitors see a "form not connected yet, please call" message.
# ---------------------------------------------------------------------------
# Email through Resend (https://resend.com, free tier available)
RESEND_API_KEY=
# Where leads go. Comma-separate multiple addresses.
LEAD_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "Website <leads@yourdomain.com>".
# Until a domain is verified, leave empty: Resend's test sender only delivers
# to the email address that owns the Resend account.
LEAD_FROM_EMAIL=

# Optional webhook that receives every lead as JSON (Zapier, Make, n8n, a CRM,
# or a Google Sheet through Apps Script).
LEAD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Spam protection: Cloudflare Turnstile (free). Set both or neither.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Analytics and ads. Use GTM OR GA4 directly, not both.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# JSON map of event name to Google Ads conversion label, e.g.
# {"click_phone":"AbC123","submit_quote_request":"XyZ789"}
NEXT_PUBLIC_GOOGLE_ADS_LABELS=
NEXT_PUBLIC_META_PIXEL_ID=
